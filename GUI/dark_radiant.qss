/* =========================================================================
   RadiAnt DICOM UX Edition - RadDoc Dark Blue Medical Theme
   High-contrast, professional radiological ergonomic theme matching RadDoc
   ========================================================================= */

QWidget {
    background-color: #071728;
    color: #E2E8F0;
    font-family: "Segoe UI", Arial, sans-serif;
    font-size: 11px;
    selection-background-color: #0284C7;
    selection-color: #FFFFFF;
}

/* Absolute Black for Radiological Viewports */
QGraphicsView,
QOpenGLWidget,
#view2d_frame,
#view3d_frame,
#gl_frame {
    background-color: #000000;
    border: none;
}

/* Main Window & Dialogs */
QMainWindow, QDialog {
    background-color: #071728;
}

/* Menu Bar */
QMenuBar {
    background-color: #0A192F;
    color: #ABC9EC;
    border-bottom: 1px solid #173350;
    padding: 2px 4px;
}

QMenuBar::item {
    background: transparent;
    padding: 4px 10px;
    border-radius: 3px;
}

QMenuBar::item:selected {
    background-color: #1A324B;
    color: #FFFFFF;
}

/* Dropdown Menus */
QMenu {
    background-color: #0A192F;
    color: #E2E8F0;
    border: 1px solid #1E3A5F;
    padding: 5px;
    border-radius: 4px;
}

QMenu::item {
    padding: 5px 24px 5px 20px;
    border-radius: 3px;
}

QMenu::item:selected {
    background-color: #0284C7;
    color: #FFFFFF;
    font-weight: 500;
}

QMenu::separator {
    height: 1px;
    background-color: #173350;
    margin: 4px 8px;
}

/* Top Unified Toolbar (RadDoc Dark Blue) */
QToolBar {
    background-color: #0D2137;
    border: none;
    border-bottom: 1px solid #173350;
    spacing: 3px;
    padding: 3px 6px;
}

QToolBar::separator {
    width: 1px;
    background-color: #173350;
    margin: 4px 6px;
}

/* Tool Buttons with RadDoc Dark Blue Contrast Gradient */
QToolButton {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1A324B, stop:1 #112233);
    color: #FFFFFF;
    border: 1px solid #234567;
    border-radius: 4px;
    padding: 4px 6px;
    margin: 1px;
    min-height: 22px;
}

QToolButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #244466, stop:1 #182E44);
    border: 1px solid #38BDF8;
    color: #FFFFFF;
}

QToolButton:pressed {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #0284C7, stop:1 #0369A1);
    border: 1px solid #38BDF8;
    color: #FFFFFF;
}

QToolButton:checked {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #0284C7, stop:1 #0369A1);
    border: 1.5px solid #38BDF8;
    color: #FFFFFF;
    font-weight: bold;
}

QToolButton::menu-indicator {
    subcontrol-origin: padding;
    subcontrol-position: bottom right;
    right: 2px;
    bottom: 2px;
}

/* Push Buttons (Dialogs & Controls) */
QPushButton {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #1A324B, stop:1 #112233);
    color: #FFFFFF;
    border: 1px solid #234567;
    border-radius: 4px;
    padding: 5px 14px;
    min-height: 20px;
    font-weight: 500;
}

QPushButton:hover {
    background-color: qlineargradient(x1:0, y1:0, x2:0, y2:1, stop:0 #244466, stop:1 #182E44);
    border: 1px solid #38BDF8;
    color: #FFFFFF;
}

QPushButton:pressed {
    background-color: #0284C7;
    border: 1px solid #38BDF8;
    color: #FFFFFF;
}

QPushButton:checked {
    background-color: #0284C7;
    border: 1px solid #38BDF8;
    color: #FFFFFF;
}

QPushButton:disabled {
    background-color: #0B192A;
    color: #556B82;
    border: 1px solid #14253A;
}

/* Dock Widgets (Thumbnail Strip) */
QDockWidget {
    background-color: #071728;
    color: #E2E8F0;
    border: 1px solid #173350;
}

QDockWidget::title {
    background-color: #0D2137;
    color: #ABC9EC;
    padding: 5px 10px;
    border-bottom: 1px solid #173350;
    font-weight: bold;
    font-size: 10px;
}

/* List Widgets & Thumbnail Strip */
QListWidget, QListView, QTableWidget, QTableView, QTreeWidget, QTreeView {
    background-color: #071728;
    color: #E2E8F0;
    border: 1px solid #173350;
    gridline-color: #173350;
    outline: none;
}

QListWidget::item, QTableWidget::item {
    padding: 3px;
    border-bottom: 1px solid #10243B;
}

QListWidget::item:hover, QTableWidget::item:hover {
    background-color: #122842;
    color: #FFFFFF;
}

QListWidget::item:selected, QTableWidget::item:selected {
    background-color: #0284C7;
    color: #FFFFFF;
}

/* Vertical Scrollbars in Grid Cells */
QScrollBar:vertical {
    background: #091624;
    width: 10px;
    margin: 0;
    border: none;
}

QScrollBar::handle:vertical {
    background: #1E3A5F;
    min-height: 24px;
    border-radius: 4px;
    margin: 1px;
}

QScrollBar::handle:vertical:hover {
    background: #38BDF8;
}

QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical {
    height: 0px;
}

QScrollBar:horizontal {
    background: #091624;
    height: 10px;
    margin: 0;
    border: none;
}

QScrollBar::handle:horizontal {
    background: #1E3A5F;
    min-width: 24px;
    border-radius: 4px;
    margin: 1px;
}

QScrollBar::handle:horizontal:hover {
    background: #38BDF8;
}

QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal {
    height: 0px;
}

/* Sliders */
QSlider::groove:vertical {
    background: #0D2137;
    width: 6px;
    border-radius: 3px;
}

QSlider::sub-page:vertical {
    background: #0284C7;
    border-radius: 3px;
}

QSlider::handle:vertical {
    background: #ABC9EC;
    height: 14px;
    margin-left: -4px;
    margin-right: -4px;
    border-radius: 7px;
    border: 1px solid #38BDF8;
}

QSlider::handle:vertical:hover {
    background: #FFFFFF;
}

QSlider::groove:horizontal {
    background: #0D2137;
    height: 6px;
    border-radius: 3px;
}

QSlider::sub-page:horizontal {
    background: #0284C7;
    border-radius: 3px;
}

QSlider::handle:horizontal {
    background: #ABC9EC;
    width: 14px;
    margin-top: -4px;
    margin-bottom: -4px;
    border-radius: 7px;
    border: 1px solid #38BDF8;
}

QSlider::handle:horizontal:hover {
    background: #FFFFFF;
}

/* Tab Widget */
QTabWidget::pane {
    border: 1px solid #173350;
    background-color: #071728;
}

QTabBar::tab {
    background-color: #0D2137;
    color: #94A3B8;
    padding: 6px 16px;
    border-top-left-radius: 4px;
    border-top-right-radius: 4px;
    margin-right: 2px;
    border: 1px solid #173350;
    border-bottom: none;
}

QTabBar::tab:hover {
    background-color: #1A324B;
    color: #FFFFFF;
}

QTabBar::tab:selected {
    background-color: #0284C7;
    color: #FFFFFF;
    font-weight: bold;
    border: 1px solid #38BDF8;
    border-bottom: none;
}

/* Status Bar */
QStatusBar {
    background-color: #0A192F;
    color: #94A3B8;
    border-top: 1px solid #173350;
}

QStatusBar::item {
    border: none;
}

/* Input Fields & Spinners */
QLineEdit, QSpinBox, QDoubleSpinBox, QComboBox {
    background-color: #0D2137;
    color: #FFFFFF;
    border: 1px solid #234567;
    border-radius: 3px;
    padding: 3px 6px;
}

QLineEdit:focus, QSpinBox:focus, QDoubleSpinBox:focus, QComboBox:focus {
    border: 1.5px solid #38BDF8;
}

/* Checkboxes and Radio Buttons */
QCheckBox, QRadioButton {
    color: #E2E8F0;
    spacing: 6px;
}

QCheckBox::indicator, QRadioButton::indicator {
    width: 15px;
    height: 15px;
    border: 1px solid #234567;
    background-color: #0D2137;
    border-radius: 3px;
}

QRadioButton::indicator {
    border-radius: 8px;
}

QCheckBox::indicator:hover, QRadioButton::indicator:hover {
    border: 1px solid #38BDF8;
}

QCheckBox::indicator:checked, QRadioButton::indicator:checked {
    background-color: #0284C7;
    border: 1px solid #38BDF8;
}

/* Multi-View Grid Frame active cell highlight */
#frame0[active_cell="true"] {
    border: 2px solid #38BDF8;
}

#frame0[active_cell="false"] {
    border: 1px solid #173350;
}
